// gow3: the HDR scene color before the temporal upscaler, in place. Pixels that are NaN, infinite
// or negative (the brightest lights of Gravity Rush can overflow) become finite: FSR and DLSS
// would otherwise keep them in their history as black patches that flash for several frames.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D scene;

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(scene)))) {
        return;
    }
    const vec4 value = imageLoad(scene, pixel);
    vec3 color = value.rgb;
    color = mix(color, vec3(0.0), bvec3(isnan(color.r), isnan(color.g), isnan(color.b)));
    color = clamp(color, vec3(0.0), vec3(60000.0));
    if (color != value.rgb) {
        imageStore(scene, pixel, vec4(color, value.a));
    }
}
